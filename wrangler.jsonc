/**
 * wrangler.jsonc — Wallet Ledger API worker configuration.
 *
 * KV bindings:
 *  - ACCOUNTS    — one key per account (account:<id>)
 *  - LEDGER      — append-only entries, keyed ledger:<accountId>:<ts>:<entryId>
 *  - IDEMPOTENCY — transfer idempotency records with 24h TTL
 *
 * Secrets (set via `wrangler secret put <NAME>`):
 *  - DEMO_API_TOKEN — shared bearer token for write endpoints
 *
 * Assets:
 *  - public/ is served via the ASSETS binding. The Worker route handler at
 *    /ui fetches index.html from the binding so we control caching headers.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wallet-ledger-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS",
		"not_found_handling": "none",
		"run_worker_first": ["/*"]
	},
	"kv_namespaces": [
		{
			"binding": "ACCOUNTS",
			"id": "2529a7e15ba1492ebed0e7f577118166",
			"preview_id": "4d689c28180f4b1b9691f917a56a9fdc"
		},
		{
			"binding": "LEDGER",
			"id": "f095d0600f75409f855f441c6e9f01de",
			"preview_id": "3bc5f727939c40bab163640815e409e4"
		},
		{
			"binding": "IDEMPOTENCY",
			"id": "65062e43521c4170b26268cbc58cecc0",
			"preview_id": "c1bfd6c5e6704620bd2a9252a67155ff"
		}
	]
}
